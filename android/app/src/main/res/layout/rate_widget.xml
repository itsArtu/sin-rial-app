<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rate_pair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USD/VES"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rate_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0,00%"
            android:textColor="#58BE86"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/rate_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Bs 0,00"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:includeFontPadding="false"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rate_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Actualizado"
        android:textColor="#CCFFFFFF"
        android:textSize="8sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textStyle="bold" />
</LinearLayout>
